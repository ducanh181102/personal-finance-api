  "item": [
    {
      "name": "01 - CRUD theo thứ tự",
      "description": "Chạy 01–10 theo thứ tự. Chỉ tạo, sửa và xóa tài khoản test được tạo trong folder này.",
      "item": [
        {
          "name": "01 - Kiểm tra ứng dụng",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Kiểm tra ứng dụng Spring Boot đã khởi động ở base_url.\n\nMã HTTP mong đợi: 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Ứng dụng đang chạy\", function () { pm.expect(pm.response.text()).to.eql(\"Personal Finance API is running\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Tạo tài khoản test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/accounts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "description": "Tạo dữ liệu giả dành riêng cho lượt test. Tự lưu ID vào collection variable account_id. Chạy request này trước các request 03–10.\n\nMã HTTP mong đợi: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{test_account_name}}\",\n  \"type\": \"CASH\",\n  \"openingBalance\": 500000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"account_id\", \"\");",
                  "pm.collectionVariables.set(\"test_account_name\", \"PM Test \" + Date.now());",
                  "pm.collectionVariables.set(\"updated_account_name\", \"PM Test renamed \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Tài khoản được tạo đúng dữ liệu và có ID\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(body.name).to.eql(pm.collectionVariables.get(\"test_account_name\"));",
                  "    pm.expect(body.type).to.eql(\"CASH\");",
                  "    pm.expect(body.openingBalance).to.eql(500000);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const created = pm.response.json();",
                  "    if (Number.isInteger(created.id) && created.id > 0) {",
                  "        pm.collectionVariables.set(\"account_id\", String(created.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
