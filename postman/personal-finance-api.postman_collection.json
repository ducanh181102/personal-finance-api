          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ownedId = pm.collectionVariables.get(\"account_id\");",
                  "if (!ownedId) {",
                  "    console.warn(\"Chạy request 02 - Tạo tài khoản test trước. Request này được bỏ qua vì chưa có account_id.\");",
                  "    pm.execution.skipRequest();",
                  "} else {",
                  "    pm.variables.set(\"account_id\", String(ownedId));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Danh sách chứa tài khoản test\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    pm.expect(body.some(function (account) { return account.id === Number(pm.collectionVariables.get(\"account_id\")); })).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
